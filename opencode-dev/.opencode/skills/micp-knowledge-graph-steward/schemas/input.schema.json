{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://obsidian.panshi/skills/micp-knowledge-graph-steward/input.schema.json",
  "title": "micp-knowledge-graph-steward input contract",
  "description": "Unified skill input envelope (Obsidian Plan spec §六) plus knowledge-graph action payloads. contract_version 1.0.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "task_id", "project_id", "request", "action", "skill_version", "timestamp"],
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "SemVer-ish contract version. The runtime checks the major: 1.x accepted, 2.x rejected with KGE-E801 (compat policy, spec §十一)."
    },
    "task_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "project_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._-]{1,64}$",
      "description": "Stream name. Also filesystem-safe by construction."
    },
    "request": {"type": "string", "minLength": 1, "description": "Natural-language task statement (spec §六)."},
    "action": {
      "type": "string",
      "enum": [
        "kb.init", "kb.get", "kb.list", "kb.backup", "kb.restore",
        "kb.migrate", "kb.integrity",
        "graph.upsert_entity", "graph.add_relation", "graph.remove_relation",
        "graph.add_claim", "graph.supersede_claim", "graph.retract_claim",
        "graph.evidence_register", "graph.evidence_retract",
        "graph.evidence_chain", "graph.conflict_scan", "graph.conflict_resolve",
        "graph.ontology", "graph.ontology_update", "graph.query",
        "graph.import", "graph.export",
        "approval.grant"
      ]
    },
    "context": {"type": "object", "description": "Controller-supplied working context (ephemeral tier)."},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "data_refs": {"type": "array", "items": {"type": "string"}},
    "upstream_outputs": {"type": "array", "items": {"type": "object"}},
    "requested_output_format": {"type": "string", "enum": ["json", "yaml", "graph", "summary"], "default": "json"},
    "risk_level": {"type": "string", "enum": ["low", "medium", "high", "critical"], "default": "low"},
    "human_approval_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["granted"],
      "properties": {
        "granted": {"type": "boolean"},
        "approver": {"type": "string"},
        "revision": {"type": "integer", "minimum": 0,
                     "description": "Stream revision the approval was granted against; stale approvals are rejected (KGE-E503)."},
        "scope": {"type": "string"}
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role"],
      "properties": {
        "role": {"type": "string", "enum": ["controller", "skill", "human", "auditor"]},
        "id": {"type": "string"}
      },
      "default": {"role": "skill"}
    },
    "skill_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "controller_version": {"type": "string"},
    "timestamp": {"type": "string", "description": "ISO-8601 caller timestamp."},
    "expected_revision": {
      "type": "integer", "minimum": 0,
      "description": "Optimistic concurrency: caller's view of stream head. Mismatch => KGE-E101."
    },
    "dry_run": {"type": "boolean", "default": false,
                "description": "Validate + simulate only; no events appended, no snapshot written."},
    "reason": {"type": "string"},

    "title": {"type": "string", "description": "kb.init: human title for the knowledge base."},
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entity_type"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "entity_type": {
          "type": "string",
          "enum": ["STRAIN", "ENZYME", "SUBSTRATE", "REACTANT", "PRODUCT", "ION",
                   "MINERAL_PHASE", "POROUS_MEDIUM", "PROCESS", "INSTRUMENT",
                   "EXPERIMENT", "PROPERTY", "METRIC", "ENV_INDICATOR", "METHOD", "ARTIFACT"]
        },
        "canonical_name": {"type": "string"},
        "display_name": {"type": "string"},
        "attrs": {"type": "object", "description": "Free-form entity attributes (strain lineage, substrate formula, ...)."},
        "created_by": {"type": "string"}
      },
      "description": "graph.upsert_entity payload."
    },
    "aliases": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "description": "Synonym/alias strings that map to the entity id (recorded in the KB alias index)."
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from_id", "to_id", "relation_type"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "from_id": {"type": "string", "minLength": 1},
        "to_id": {"type": "string", "minLength": 1},
        "relation_type": {
          "type": "string",
          "enum": ["HAS_TYPE", "SYNONYM_OF", "RELATED_TO", "CATALYZES", "CONSUMES",
                   "PRODUCES", "MEASURED_BY", "OBSERVED_IN", "SAME_AS", "IS_PHASE_OF",
                   "APPLIES_TO", "EVIDENCE_FOR", "EVIDENCE_AGAINST", "PARTOF",
                   "DEPENDS_ON", "SUPPORTS", "REFUTES"]
        },
        "attrs": {"type": "object"}
      },
      "description": "graph.add_relation payload."
    },
    "relation_id": {"type": "string", "description": "graph.remove_relation target."},
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "claim_kind", "subject", "predicate", "evidence_tier", "epistemic_label"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "claim_kind": {
          "type": "string",
          "enum": ["IDENTITY", "TYPE", "SYNONYM", "VALUE", "OBSERVATION", "CAUSAL", "NORMATIVE"]
        },
        "subject": {"type": "string", "minLength": 1},
        "subject_is_alias": {"type": "boolean", "default": false,
                             "description": "When true, subject is a lexical alias, not a required entity id."},
        "predicate": {"type": "string", "minLength": 1},
        "object": {"type": "string", "description": "Categorical object (mineral phase, strain name, ...)."},
        "quantity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "unit"],
          "properties": {
            "value": {"type": "number"},
            "unit": {"type": "string", "minLength": 1}
          },
          "description": "VALUE claims: numeric quantity with unit (unit-checked, KGE-E203)."
        },
        "polarity": {"type": "string", "enum": ["increases", "decreases"],
                     "description": "CAUSAL claims: direction of influence."},
        "evidence_tier": {
          "type": "string",
          "enum": ["EXTERNAL_REPORTED", "INTERNAL_OBSERVED", "CALCULATED", "INFERRED",
                   "HYPOTHESIS", "VALIDATED"]
        },
        "epistemic_label": {
          "type": "string",
          "enum": ["OBSERVED", "REPORTED", "CALCULATED", "INFERRED", "HYPOTHESIS", "RECOMMENDATION"]
        },
        "confidence": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH"]},
        "evidence_refs": {"type": "array", "items": {"type": "string"},
                          "description": "Registered evidence records supporting the claim."},
        "evidence_hashes": {"type": "object",
                            "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                            "description": "Optional content-hash assertions per evidence ref; mismatch => KGE-E202."},
        "domain_range": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3,
                         "description": "[low, high, unit-index] — replaced by named ranges; see 'range'."},
        "range": {"type": "string", "description": "Named domain range: temperature | caco3_content_percent | urea_conc_mol_l | ph."},
        "attrs": {"type": "object"},
        "asserted_at": {"type": "string"}
      },
      "description": "graph.add_claim / graph.supersede_claim replacement payload."
    },
    "claim_id": {"type": "string", "description": "graph.supersede_claim old claim / graph.retract_claim target."},
    "replacement": {
      "type": "object",
      "description": "graph.supersede_claim: the replacement claim (same schema as 'claim')."
    },
    "evidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref"],
          "properties": {
            "ref": {"type": "string", "minLength": 1, "maxLength": 256},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "tier": {"type": "string",
                     "enum": ["EXTERNAL_REPORTED", "INTERNAL_OBSERVED", "CALCULATED", "INFERRED",
                              "HYPOTHESIS", "VALIDATED"]},
            "source": {"type": "string"},
            "summary": {"type": "string"},
            "content_hash_source": {"type": "string", "description": "Where the content hash was computed (file, citation, raw)."}
          }
        },
        {
          "type": "array",
          "items": {"$ref": "#/properties/evidence/oneOf/0"},
          "description": "graph.add_claim: inline registration of one or more evidence records in the same mutation."
        }
      ],
      "description": "graph.evidence_register payload, or a list for graph.add_claim inline registration."
    },
    "ref": {"type": "string", "description": "graph.evidence_retract target ref."},
    "archive": {"type": "string", "description": "kb.restore: path to a backup zip."},
    "label": {"type": "string", "description": "kb.backup: human label embedded in the archive name."},
    "conflict_id": {"type": "string", "description": "graph.conflict_resolve target conflict."},
    "preferred_claim": {"type": "string",
                        "description": "graph.conflict_resolve: the claim the adjudication prefers."},
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["entity", "claim", "claim_by_subject", "evidence", "conflict", "alias"]
        },
        "id": {"type": "string"},
        "subject": {"type": "string"}
      },
      "description": "graph.query payload."
    },
    "format": {"type": "string", "enum": ["json", "yaml"], "description": "graph.export / graph.import document format."},
    "path": {"type": "string", "description": "graph.export: optional target file path."},
    "document": {"type": "object",
                 "description": "graph.import: in-memory graph document (export shape)."},
    "content": {"type": "string",
                "description": "graph.import: serialized JSON/YAML graph document."},
    "add_entity_types": {"type": "array", "items": {"type": "string"},
                         "description": "graph.ontology_update: new UPPER_SNAKE entity types to add."},
    "add_relation_types": {"type": "array", "items": {"type": "string"},
                           "description": "graph.ontology_update: new UPPER_SNAKE relation types to add."},
    "replace": {"type": "boolean", "default": false,
                "description": "graph.ontology_update: true = breaking replacement (approval-gated)."},
    "ontology_version": {"type": "integer", "minimum": 1,
                         "description": "graph.ontology_update: explicit version to record."},
    "approver": {"type": "string", "description": "approval.grant: human approver identity."},
    "scope": {"type": "string", "description": "approval.grant / approval scope label."},
    "notes": {"type": "string"}
  }
}
