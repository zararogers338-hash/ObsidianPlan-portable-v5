{
  "$schema": "https://obsidian.dev/manifest.schema.json",
  "name": "obsidian-mission-lock",
  "title": "Obsidian Mission Lock | 研究任务定界与使命锁定",
  "version": "1.0.0",
  "contract_version": "1.0.0",
  "layer": "panshi-governed-capability",
  "license": "MIT",
  "compatibility": {
    "opencode": ">=1.18",
    "runtime": "bun >=1.3",
    "node": ">=18"
  },
  "entrypoint": "tools/src/cli.ts",
  "discovery": {
    "format": "SKILL.md",
    "locations": [".opencode/skills/", ".claude/skills/", ".agents/skills/"]
  },
  "inputs": {
    "schema": "schemas/input.schema.json",
    "reference": "https://obsidian.dev/skills/obsidian-mission-lock/input.schema.json"
  },
  "outputs": {
    "schema": "schemas/output.schema.json",
    "statuses": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "NEED_ADDITIONAL_SKILL", "HUMAN_APPROVAL_REQUIRED"]
  },
  "errors": ["OML-E1001", "OML-E1002", "OML-E1003", "OML-E1004", "OML-E1005", "OML-E1006", "OML-E1007", "OML-E1008", "OML-E1009", "OML-E1010"],
  "tools": [
    { "name": "lock", "entrypoint": "tools/src/cli.ts", "subcommand": "lock", "purpose": "Full pipeline: envelope validation, missing-field & conflict detection, unit check, contract schema validation, approval gating" },
    { "name": "validate", "entrypoint": "tools/src/cli.ts", "subcommand": "validate", "purpose": "Validate a contract JSON against contract schema + unit check" },
    { "name": "diff", "entrypoint": "tools/src/cli.ts", "subcommand": "diff", "purpose": "Diff two contract versions; goal-drift / objective-substitution detection" },
    { "name": "units", "entrypoint": "tools/src/cli.ts", "subcommand": "units", "purpose": "Unit / scale / temporal consistency check on a contract" }
  ],
  "permissions": {
    "read": "project files (read-only)",
    "write": "audit/ directory only",
    "requires_approval": ["network access", "external writes", "experiment execution", "invoking other skills"]
  },
  "offline": true,
  "deterministic": true
}
