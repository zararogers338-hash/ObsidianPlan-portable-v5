{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "obsidian-prompt-amplifier/input.schema.json",
  "title": "obsidian-prompt-amplifier input",
  "type": "object",
  "required": ["task_id", "project_id", "request"],
  "properties": {
    "task_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "request": { "type": "string", "minLength": 1 },
    "context": { "type": "object" },
    "max_amplification_rounds": { "type": "integer", "minimum": 1, "maximum": 2, "default": 2 }
  },
  "additionalProperties": true
}
