{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://obsidian.dev/skills/micp-instrumentation-qc/input.schema.json",
  "title": "micp-instrumentation-qc input envelope",
  "description": "Envelope passed by the Obsidian controller when invoking the skill. Custom project convention (Obsidian Plan), version 1.0.0.",
  "type": "object",
  "required": ["task_id", "project_id", "request", "skill_version", "controller_version", "timestamp"],
  "additionalProperties": false,
  "properties": {
    "task_id": { "type": "string", "minLength": 1, "description": "Unique task identifier (UUID/ULID), generated by the controller" },
    "project_id": { "type": "string", "minLength": 1 },
    "request": { "type": "string", "minLength": 1, "description": "Verbatim natural-language user request" },
    "context": { "type": "object", "description": "Free-form context. Reserved keys: qc_plan, pathway, matrix (MICP domain)" },
    "constraints": {
      "type": "object",
      "properties": {
        "dry_run": { "type": "boolean", "default": true },
        "allow_derived_write": { "type": "boolean", "default": false },
        "output_dir": { "type": "string" },
        "audit_log": { "type": "string" }
      },
      "additionalProperties": true,
      "description": "dry_run=true by default; data writes require human approval"
    },
    "evidence_refs": { "type": "array", "items": { "type": "string" }, "description": "URIs/paths/DOIs of evidence the skill may cite" },
    "data_refs": { "type": "array", "items": { "type": "string" }, "description": "URIs/paths of raw data files the skill may hash/verify" },
    "upstream_outputs": { "type": "array", "items": true, "description": "Outputs from previously run skills" },
    "requested_output_format": {
      "type": "string",
      "enum": ["qc_report", "qc_plan", "integrity_report", "calibration_report"],
      "default": "qc_report"
    },
    "risk_level": { "type": "string", "enum": ["low", "medium", "high", "critical"], "default": "medium" },
    "human_approval_state": { "type": "string", "enum": ["not_required", "pending", "approved", "rejected"], "default": "not_required" },
    "skill_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "Skill version the caller expects; cross-major mismatch without migration is rejected (MICQ-E1010)" },
    "controller_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "qc_input": {
      "type": "object",
      "description": "QC-specific payload. At least one of instruments/calibrations/measurements/samples/raw/derived must be present when requested_output_format != qc_plan.",
      "properties": {
        "instruments": {
          "type": "array",
          "items": { "$ref": "#/$defs/instrument" },
          "description": "Instrument registry: model, serial, software, calibration reference, LOD/LOQ, uncertainty, range, saturation threshold"
        },
        "calibrations": {
          "type": "array",
          "items": { "$ref": "#/$defs/calibration" },
          "description": "Calibration records: standard concentration vs response, date, operator, status"
        },
        "measurements": {
          "type": "array",
          "items": { "$ref": "#/$defs/measurement" },
          "description": "Measurement records to QC: value, unit, timestamp, instrument ref, method, QC criteria"
        },
        "samples": {
          "type": "array",
          "items": { "$ref": "#/$defs/sample" },
          "description": "Sample chain: id, barcode, collection/receipt/storage/transport/preparation records"
        },
        "raw": { "type": "array", "items": { "type": "string" }, "description": "Paths/contents of raw data for integrity hashing" },
        "derived": { "type": "array", "items": { "type": "object" }, "description": "Derived data records that must reference raw via raw_sha256" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "instrument": {
      "type": "object",
      "required": ["instrument_id", "kind", "model"],
      "properties": {
        "instrument_id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "description": "e.g. pH, EC, NH4, Ca2, OD600, enzyme, flow, pressure, mass, UCS, XRD, SEM" },
        "model": { "type": "string", "minLength": 1 },
        "serial": { "type": "string" },
        "software_version": { "type": "string" },
        "calibration_ref": { "type": "string", "description": "Reference to a calibration record id" },
        "calibration_date": { "type": "string", "format": "date" },
        "detection_limit": { "type": "number", "description": "LOD in the instrument's primary unit" },
        "quantification_limit": { "type": "number", "description": "LOQ in the instrument's primary unit" },
        "expanded_uncertainty": { "type": "number" },
        "unit": { "type": "string" },
        "measurement_range": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "saturation_threshold": { "type": "number" }
      },
      "additionalProperties": false
    },
    "calibration": {
      "type": "object",
      "required": ["calibration_id", "instrument_id", "method", "status", "standards"],
      "properties": {
        "calibration_id": { "type": "string", "minLength": 1 },
        "instrument_id": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "description": "e.g. linear, quadratic; must match the module's supported methods" },
        "status": { "type": "string", "enum": ["passed", "failed", "pending"] },
        "date": { "type": "string", "format": "date" },
        "operator": { "type": "string" },
        "standards": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["concentration", "response"],
            "properties": {
              "concentration": { "type": "number" },
              "response": { "type": "number" },
              "unit": { "type": "string" }
            },
            "additionalProperties": false
          },
          "minItems": 2,
          "description": "At least 2 standard points"
        }
      },
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "required": ["measurement_id", "instrument_id", "sample_id", "value", "unit", "timestamp"],
      "properties": {
        "measurement_id": { "type": "string", "minLength": 1 },
        "instrument_id": { "type": "string", "minLength": 1 },
        "sample_id": { "type": "string", "minLength": 1 },
        "value": { "type": "number" },
        "unit": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "method": { "type": "string" },
        "qc": { "type": "object", "properties": { "mean": { "type": "number" }, "sd": { "type": "number" }, "range": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 } }, "additionalProperties": false }
      },
      "additionalProperties": false
    },
    "sample": {
      "type": "object",
      "required": ["sample_id", "collection_time"],
      "properties": {
        "sample_id": { "type": "string", "minLength": 1 },
        "barcode": { "type": "string" },
        "collection_time": { "type": "string", "format": "date-time" },
        "received_time": { "type": "string", "format": "date-time" },
        "storage_condition": { "type": "string" },
        "transport_record": { "type": "string" },
        "preparation": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
