{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://obsidian.local/schemas/micp-evidence-extractor.output.json",
  "title": "MICP Evidence Extractor — Output Contract",
  "description": "Unified output envelope for the micp-evidence-extractor skill (MEE). Twelve contract fields (status/summary/findings/assumptions/evidence_used/uncertainty/risks/artifacts/requested_next_skills/validation/provenance/errors) plus extraction-specific sections: document metadata, doi_verifications, isolation_report (experimental-group and time-point isolation), evidence_cards (each validating against schemas/evidence-card.schema.json), and extractor_stats. Every load-bearing claim carries an epistemic tag; every quantity carries an acquisition mode. Version 1.0.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "findings",
    "assumptions",
    "evidence_used",
    "uncertainty",
    "risks",
    "artifacts",
    "requested_next_skills",
    "validation",
    "provenance",
    "errors"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "SUCCESS",
        "PARTIAL",
        "BLOCKED",
        "FAILED",
        "NEED_ADDITIONAL_SKILL",
        "HUMAN_APPROVAL_REQUIRED"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6000
    },
    "findings": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement",
          "epistemic_tag"
        ],
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "epistemic_tag": {
            "type": "string",
            "enum": [
              "OBSERVED",
              "REPORTED",
              "CALCULATED",
              "INFERRED",
              "HYPOTHESIS",
              "RECOMMENDATION"
            ]
          },
          "source": {
            "type": "string",
            "maxLength": 2000,
            "description": "Mandatory when epistemic_tag is OBSERVED or REPORTED."
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement"
        ],
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "falsifiable_by": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    },
    "evidence_used": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref_id"
        ],
        "properties": {
          "ref_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "how_used": {
            "type": "string",
            "maxLength": 2000
          },
          "verifiable": {
            "type": "boolean"
          },
          "note": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    },
    "uncertainty": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic",
          "level"
        ],
        "properties": {
          "topic": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "level": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "risk",
          "severity"
        ],
        "properties": {
          "risk": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "mitigation": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "kind",
          "content_type"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "kind": {
            "type": "string",
            "enum": [
              "evidence_card",
              "evidence_cards_json",
              "evidence_cards_csv",
              "evidence_cards_yaml",
              "extraction_report",
              "isolation_report",
              "digitization_report",
              "reproducibility_manifest"
            ]
          },
          "content_type": {
            "type": "string",
            "enum": [
              "application/json",
              "application/yaml",
              "text/csv",
              "text/plain",
              "text/markdown"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "payload": {
            "type": "object"
          }
        }
      }
    },
    "requested_next_skills": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "skill",
          "reason"
        ],
        "properties": {
          "skill": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "inputs_needed": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500
            },
            "maxItems": 20
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "self_audit_pass",
        "gates"
      ],
      "properties": {
        "self_audit_pass": {
          "type": "boolean"
        },
        "gates": {
          "type": "object"
        },
        "tool_runs": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tool",
              "ok"
            ],
            "properties": {
              "tool": {
                "type": "string",
                "maxLength": 128
              },
              "ok": {
                "type": "boolean"
              },
              "detail": {
                "type": "string",
                "maxLength": 1000
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill",
        "skill_version",
        "generated_at",
        "generator"
      ],
      "properties": {
        "skill": {
          "type": "string",
          "const": "micp-evidence-extractor"
        },
        "skill_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "generated_at": {
          "type": "string",
          "maxLength": 40
        },
        "generator": {
          "type": "string",
          "maxLength": 128
        },
        "input_task_id": {
          "type": "string",
          "maxLength": 128
        },
        "tool_versions": {
          "type": "object"
        },
        "input_digest": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "errors": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "retryable": {
            "type": "boolean"
          },
          "details": {
            "type": "object"
          }
        }
      }
    },
    "missing_inputs": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "why_critical",
          "how_to_obtain"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "why_critical": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "how_to_obtain": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "document": {
      "type": "object",
      "description": "Parsed/normalized source metadata (the extractor's view of the source document).",
      "additionalProperties": true
    },
    "doi_verifications": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "doi",
          "resolved",
          "status",
          "evidence"
        ],
        "properties": {
          "doi": {
            "type": "string",
            "maxLength": 300
          },
          "resolved": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "verifiable_structure",
              "suspected_forged",
              "offline_unverified",
              "verified_online",
              "not_found",
              "check_failed"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 1000
          },
          "container": {
            "type": "string",
            "maxLength": 300
          },
          "year": {
            "type": "string",
            "maxLength": 20
          },
          "evidence": {
            "type": "string",
            "maxLength": 100
          },
          "reason": {
            "type": "string",
            "maxLength": 2000
          },
          "mismatches": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field"
              ],
              "properties": {
                "field": {
                  "type": "string",
                  "maxLength": 100
                },
                "claimed": {
                  "type": "string"
                },
                "actual": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "isolation_report": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "check_id",
        "passed"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "passed": {
          "type": "boolean"
        },
        "issues": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "severity",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "maxLength": 64
              },
              "severity": {
                "type": "string",
                "enum": [
                  "error",
                  "warning",
                  "info"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "details": {
                "type": "object"
              }
            }
          }
        },
        "group_binding_issues": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object"
          }
        },
        "timepoint_binding_issues": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object"
          }
        }
      }
    },
    "duplicates_contradictions": {
      "type": "object",
      "description": "Duplicate-value and internal-contradiction check results across evidence cards.",
      "additionalProperties": true,
      "required": [
        "check_id",
        "passed"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "maxLength": 128
        },
        "passed": {
          "type": "boolean"
        },
        "issues": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "severity",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "maxLength": 64
              },
              "severity": {
                "type": "string",
                "enum": [
                  "error",
                  "warning",
                  "info"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "details": {
                "type": "object"
              }
            }
          }
        },
        "quantities_scanned": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "card_validation": {
      "type": "object",
      "description": "Per-card validation summary against schemas/evidence-card.schema.json.",
      "additionalProperties": true,
      "required": [
        "total",
        "passed"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "valid": {
          "type": "integer",
          "minimum": 0
        },
        "invalid": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object"
          }
        }
      }
    },
    "evidence_cards": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "description": "Each card validates against schemas/evidence-card.schema.json.",
        "additionalProperties": true
      }
    },
    "extractor_stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documents_parsed",
        "tables_parsed",
        "cards_built",
        "quantity_count"
      ],
      "properties": {
        "documents_parsed": {
          "type": "integer",
          "minimum": 0
        },
        "tables_parsed": {
          "type": "integer",
          "minimum": 0
        },
        "cards_built": {
          "type": "integer",
          "minimum": 0
        },
        "quantity_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "anyOf": [
        {
          "properties": {
            "status": {
              "const": "SUCCESS"
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "PARTIAL"
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "FAILED"
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "NEED_ADDITIONAL_SKILL"
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "HUMAN_APPROVAL_REQUIRED"
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "BLOCKED"
            }
          },
          "required": [
            "missing_inputs"
          ]
        }
      ]
    }
  ]
}
