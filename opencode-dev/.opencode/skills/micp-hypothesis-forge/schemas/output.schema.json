{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://obsidian.dev/skills/micp-hypothesis-forge/schemas/output.schema.json",
  "title": "micp-hypothesis-forge output contract",
  "description": "Machine-readable output envelope. Every status, label, and reference is validated; BLOCKED carries missing_inputs; NEED_ADDITIONAL_SKILL names the skill and inputs.",
  "type": "object",
  "required": [
    "contract_version", "skill", "skill_version", "status", "summary",
    "findings", "assumptions", "evidence_used", "uncertainty", "risks",
    "artifacts", "requested_next_skills", "validation", "provenance", "errors"
  ],
  "properties": {
    "contract_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "skill": { "const": "micp-hypothesis-forge" },
    "skill_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "NEED_ADDITIONAL_SKILL", "HUMAN_APPROVAL_REQUIRED"]
    },
    "summary": { "type": "string", "minLength": 1 },
    "missing_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "why_critical", "how_to_obtain"],
        "properties": {
          "field": { "type": "string", "minLength": 1 },
          "why_critical": { "type": "string", "minLength": 1 },
          "how_to_obtain": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "epistemic_label", "summary"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "epistemic_label": {
            "type": "string",
            "enum": ["OBSERVED", "REPORTED", "CALCULATED", "INFERRED", "HYPOTHESIS", "RECOMMENDATION"]
          },
          "summary": { "type": "string", "minLength": 1 },
          "detail": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": true
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "evidence_used": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref_id", "role"],
        "properties": {
          "ref_id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "uncertainty": { "type": "object" },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "epistemic_label", "risk"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "epistemic_label": {
            "type": "string",
            "enum": ["OBSERVED", "REPORTED", "CALCULATED", "INFERRED", "HYPOTHESIS", "RECOMMENDATION"]
          },
          "risk": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["hypothesis_card", "hypothesis_card_set", "discriminating_matrix", "experiment_priority", "dag"]
          },
          "format": { "type": "string", "enum": ["application/json", "text/markdown"] },
          "content": { "type": "object" },
          "markdown": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "requested_next_skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["skill", "inputs_needed", "reason"],
        "properties": {
          "skill": { "type": "string", "minLength": 1 },
          "inputs_needed": { "type": "array", "items": { "type": "string" } },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "validation": { "type": "object" },
    "provenance": {
      "type": "object",
      "required": ["skill", "skill_version", "timestamp", "contract_version", "controller_version"],
      "properties": {
        "skill": { "type": "string" },
        "skill_version": { "type": "string" },
        "timestamp": { "type": "string", "minLength": 1 },
        "contract_version": { "type": "string" },
        "controller_version": { "type": "string" },
        "run_id": { "type": "string" }
      },
      "additionalProperties": true
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "retryable": { "type": "boolean" },
          "details": { "type": "object" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
