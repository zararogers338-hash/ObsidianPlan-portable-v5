{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://obsidian.dev/skills/micp-experiment-designer/input.schema.json",
  "title": "micp-experiment-designer input envelope",
  "description": "Envelope passed by the Obsidian controller when invoking the skill. Custom project convention (Obsidian Plan), version 1.0.0. A Hypothesis Card becomes an executable, reproducible, controlled experiment design + SOP.",
  "type": "object",
  "required": ["task_id", "project_id", "request", "skill_version", "timestamp"],
  "additionalProperties": false,
  "properties": {
    "task_id": { "type": "string", "minLength": 1, "description": "Unique task identifier (UUID/ULID), generated by the controller" },
    "project_id": { "type": "string", "minLength": 1 },
    "request": { "type": "string", "minLength": 1, "description": "Verbatim natural-language user request to convert into an experiment design" },
    "context": {
      "type": "object",
      "description": "Free-form context. Reserved keys: hypothesis_card (structured hypothesis), pathway (urea|non-urea|unknown), matrix (MICP domain), draft_design (a design object to validate programmatically)"
    },
    "constraints": {
      "type": "object",
      "description": "Named constraints: sample_budget, max_units, allowed_reagents, duration_limit, biosafety_level, require_negative_control, require_positive_control, require_blinding, require_randomization, require_replicates",
      "additionalProperties": true
    },
    "evidence_refs": { "type": "array", "items": { "type": "string" }, "description": "URIs/paths/DOIs of evidence the design may cite" },
    "data_refs": { "type": "array", "items": { "type": "string" } },
    "upstream_outputs": { "type": "array", "items": { "type": "object" }, "description": "Outputs from previously run skills (e.g. a mission-lock contract)" },
    "requested_output_format": { "type": "string", "enum": ["json", "yaml", "markdown"], "default": "json" },
    "risk_level": { "type": "string", "enum": ["low", "medium", "high", "critical"], "default": "low" },
    "human_approval_state": { "type": "string", "enum": ["not_required", "pending", "approved", "rejected"], "default": "not_required" },
    "skill_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "Skill version the caller expects; cross-major mismatch without migration is rejected (OED-E1010)" },
    "controller_version": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "hypothesis_card": {
      "type": "object",
      "description": "Structured hypothesis card (from the Hypothesis Card registry / upstream skill). When provided, the design is derived from it.",
      "properties": {
        "primary_hypothesis": { "type": "string", "minLength": 1 },
        "competing_hypotheses": { "type": "array", "items": { "type": "string" } },
        "independent_variables": { "type": "array", "items": { "type": "string" } },
        "dependent_variables": { "type": "array", "items": { "type": "string" } },
        "control_variables": { "type": "array", "items": { "type": "string" } },
        "nuisance_variables": { "type": "array", "items": { "type": "string" } },
        "pathway": { "type": "string", "enum": ["urea", "non-urea", "unknown"] },
        "domain": { "type": "string" }
      },
      "additionalProperties": true
    },
    "design": {
      "type": "object",
      "description": "Structured experiment design draft to validate/generate SOP from.",
      "properties": {
        "objective": { "type": "string" },
        "primary_hypothesis": { "type": "string" },
        "alternative_hypothesis": { "type": "string" },
        "groups": { "type": "array", "items": { "type": "string" } },
        "negative_control": { "type": "boolean" },
        "positive_control": { "type": "boolean" },
        "replicates": { "type": "integer", "minimum": 1 },
        "endpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "unit"],
            "properties": {
              "name": { "type": "string" },
              "unit": { "type": "string" },
              "direction": { "type": "string", "enum": ["maximize", "minimize", "report"] }
            }
          }
        },
        "pathway": { "type": "string", "enum": ["urea", "non-urea", "unknown"] },
        "randomization": { "type": "string" },
        "blinding": { "type": "string" },
        "sample_size_justification": { "type": "string" },
        "data_exclusion": { "type": "string" },
        "stop_condition": { "type": "string" },
        "statistical_analysis": {
          "type": "object",
          "properties": {
            "test": { "type": "string" },
            "alpha": { "type": "number", "minimum": 0, "exclusiveMinimum": 0, "maximum": 1 },
            "two_sided": { "type": "boolean" },
            "multiplicity_correction": { "type": "string" }
          }
        },
        "ammonium_accounting": { "type": "boolean" },
        "nitrogen_mass_balance": { "type": "boolean" },
        "materials": { "type": "array", "items": { "type": "object" } },
        "injection": { "type": "object" },
        "equipment": { "type": "array", "items": { "type": "string" } },
        "safety": { "type": "array", "items": { "type": "string" } },
        "data_template": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": true
    },
    "sample_size": { "type": "integer", "minimum": 1 },
    "tool_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tool"],
        "properties": {
          "tool": { "type": "string", "enum": ["doe_power", "randomizer", "quantity_calc", "sop_check", "preregister", "validate"] },
          "payload": { "type": "object" }
        },
        "additionalProperties": false
      },
      "description": "Explicit tool invocations requested by the caller (e.g. from an orchestration script)"
    }
  }
}
