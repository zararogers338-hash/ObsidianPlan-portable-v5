{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://obsidian-panshi.local/skills/obsidian-task-decomposer/schemas/output.schema.json",
  "title": "obsidian-task-decomposer output contract",
  "description": "Machine-readable output. Version 1.0.0. Every load-bearing claim carries one epistemic tag: OBSERVED | REPORTED | CALCULATED | INFERRED | HYPOTHESIS | RECOMMENDATION.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status", "summary", "findings", "assumptions", "evidence_used", "uncertainty",
    "risks", "artifacts", "requested_next_skills", "validation", "provenance", "errors"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "NEED_ADDITIONAL_SKILL", "HUMAN_APPROVAL_REQUIRED"]
    },
    "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
    "findings": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "epistemic_tag"],
        "properties": {
          "statement": {"type": "string", "minLength": 1, "maxLength": 2000},
          "epistemic_tag": {"type": "string", "enum": ["OBSERVED", "REPORTED", "CALCULATED", "INFERRED", "HYPOTHESIS", "RECOMMENDATION"]},
          "source": {"type": "string", "maxLength": 2000, "description": "Mandatory when epistemic_tag is OBSERVED or REPORTED."}
        }
      }
    },
    "assumptions": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement"],
        "properties": {
          "statement": {"type": "string", "minLength": 1, "maxLength": 2000},
          "falsifiable_by": {"type": "string", "maxLength": 2000}
        }
      }
    },
    "evidence_used": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref_id"],
        "properties": {
          "ref_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "how_used": {"type": "string", "maxLength": 2000}
        }
      }
    },
    "uncertainty": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topic", "level"],
        "properties": {
          "topic": {"type": "string", "minLength": 1, "maxLength": 500},
          "level": {"type": "string", "enum": ["low", "medium", "high"]},
          "note": {"type": "string", "maxLength": 2000}
        }
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["risk", "severity"],
        "properties": {
          "risk": {"type": "string", "minLength": 1, "maxLength": 2000},
          "severity": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
          "mitigation": {"type": "string", "maxLength": 2000}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "kind", "content_type"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "kind": {"type": "string", "enum": ["task_dag", "replan_diff", "analysis_report"]},
          "content_type": {"type": "string", "enum": ["application/json"]},
          "description": {"type": "string", "maxLength": 1000},
          "payload": {"type": "object"}
        }
      }
    },
    "requested_next_skills": {
      "type": "array",
      "maxItems": 50,
      "description": "Capabilities this skill needs the Router to provide. This skill never invokes other skills directly.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skill", "reason"],
        "properties": {
          "skill": {"type": "string", "minLength": 1, "maxLength": 128},
          "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
          "inputs_needed": {"type": "array", "items": {"type": "string", "maxLength": 500}, "maxItems": 20}
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["self_audit_pass", "gates"],
      "properties": {
        "self_audit_pass": {"type": "boolean"},
        "gates": {"type": "object"},
        "tool_runs": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tool", "ok"],
            "properties": {
              "tool": {"type": "string", "maxLength": 128},
              "ok": {"type": "boolean"},
              "detail": {"type": "string", "maxLength": 1000}
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill", "skill_version", "generated_at", "generator"],
      "properties": {
        "skill": {"type": "string", "const": "obsidian-task-decomposer"},
        "skill_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "generated_at": {"type": "string", "maxLength": 40},
        "generator": {"type": "string", "maxLength": 128, "description": "Model/agent identity that produced the plan."},
        "input_task_id": {"type": "string", "maxLength": 128},
        "tool_versions": {"type": "object"}
      }
    },
    "errors": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "retryable"],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "E_SCHEMA_INPUT", "E_SCHEMA_OUTPUT", "E_EVIDENCE_UNVERIFIABLE",
              "E_UNIT_INCONSISTENT", "E_TOOL_UNAVAILABLE", "E_PERMISSION_DENIED",
              "E_DOWNSTREAM_SKILL_MISSING", "E_HUMAN_APPROVAL_PENDING",
              "E_SELF_CHECK_FAILED", "E_CONTEXT_CORRUPT", "E_INTERNAL"
            ]
          },
          "message": {"type": "string", "minLength": 1, "maxLength": 4000},
          "retryable": {"type": "boolean"},
          "details": {"type": "object"}
        }
      }
    },
    "missing_inputs": {
      "type": "array",
      "description": "Required when status is BLOCKED: each missing field, why it is critical, and how to obtain it.",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "why_critical", "how_to_obtain"],
        "properties": {
          "field": {"type": "string", "minLength": 1, "maxLength": 200},
          "why_critical": {"type": "string", "minLength": 1, "maxLength": 1000},
          "how_to_obtain": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    }
  },
  "allOf": [
    {
      "anyOf": [
        {"properties": {"status": {"const": "SUCCESS"}}},
        {"properties": {"status": {"const": "PARTIAL"}}},
        {"properties": {"status": {"const": "FAILED"}}},
        {"properties": {"status": {"const": "NEED_ADDITIONAL_SKILL"}}},
        {"properties": {"status": {"const": "HUMAN_APPROVAL_REQUIRED"}}},
        {
          "properties": {"status": {"const": "BLOCKED"}},
          "required": ["missing_inputs"]
        }
      ]
    },
    {
      "anyOf": [
        {
          "properties": {"status": {"enum": ["SUCCESS", "PARTIAL"]}},
          "required": ["artifacts"]
        },
        {"properties": {"status": {"enum": ["BLOCKED", "FAILED", "NEED_ADDITIONAL_SKILL", "HUMAN_APPROVAL_REQUIRED"]}}}
      ]
    }
  ]
}
