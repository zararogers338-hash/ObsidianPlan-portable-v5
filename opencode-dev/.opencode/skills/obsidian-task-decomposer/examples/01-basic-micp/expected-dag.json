{
  "dag": {
    "nodes": [
      {
        "id": "lit_review",
        "title": "Survey MICP ureolysis literature",
        "kind": "evidence_retrieval",
        "primary_skill": "micp-literature-scout",
        "collaborator_skill": [],
        "inputs": ["request", "evidence_refs:whiffin2007", "evidence_refs:biogrout2011"],
        "outputs": ["evidence_shortlist"],
        "depends_on": [],
        "definition_of_done": {
          "artifact": "evidence_shortlist.json",
          "acceptance_criteria": [
            {"metric": "sources_shortlisted", "comparator": ">=", "threshold": 10, "unit": "count"},
            {"metric": "has_dedup", "comparator": "==", "threshold": true}
          ]
        },
        "failure_modes": ["no sources found", "duplicate sources"],
        "retry_policy": {"max_attempts": 2, "backoff": "linear", "on_exhaustion": "replan_local", "retryable_error_codes": ["E_TOOL_UNAVAILABLE"]},
        "risk_level": "low",
        "data_sensitivity": "public",
        "est_effort_hours": 2.0,
        "est_context_tokens": 20000,
        "max_cost_budget": {"amount": 10, "currency": "USD"},
        "human_approval_gate": false,
        "tool_permissions": ["network"]
      },
      {
        "id": "ureolysis_chem",
        "title": "Model ureolysis chemistry and ammonium mass balance",
        "kind": "mechanism_reasoning",
        "primary_skill": "micp-ureolysis-chemistry",
        "collaborator_skill": [],
        "inputs": ["lit_review:evidence_shortlist", "context"],
        "outputs": ["ammonium_mass_balance"],
        "depends_on": ["lit_review"],
        "definition_of_done": {
          "artifact": "ammonium_mass_balance.md",
          "acceptance_criteria": [
            {"metric": "n_balance_closed", "comparator": ">=", "threshold": 0.95, "unit": "-"},
            {"metric": "pathway_identified", "comparator": "==", "threshold": "ureolytic"}
          ]
        },
        "failure_modes": ["pathway is not ureolytic", "data inconsistency"],
        "retry_policy": {"max_attempts": 2, "backoff": "none", "on_exhaustion": "escalate_human", "retryable_error_codes": ["E_EVIDENCE_UNVERIFIABLE"]},
        "risk_level": "medium",
        "data_sensitivity": "internal",
        "est_effort_hours": 6.0,
        "est_context_tokens": 30000,
        "max_cost_budget": {"amount": 20, "currency": "USD"},
        "human_approval_gate": false,
        "tool_permissions": ["read_files", "write_files"]
      },
      {
        "id": "exp_design",
        "title": "Design sand-column uniformity experiment",
        "kind": "experiment_design",
        "primary_skill": "micp-experiment-designer",
        "collaborator_skill": [],
        "inputs": ["ureolysis_chem:ammonium_mass_balance"],
        "outputs": ["protocol"],
        "depends_on": ["ureolysis_chem"],
        "definition_of_done": {
          "artifact": "protocol.md",
          "acceptance_criteria": [
            {"metric": "control_replicates", "comparator": ">=", "threshold": 3, "unit": "count"},
            {"metric": "has_spatial_sampling_plan", "comparator": "==", "threshold": true}
          ]
        },
        "failure_modes": ["confounded design", "missing controls"],
        "retry_policy": {"max_attempts": 1, "backoff": "none", "on_exhaustion": "escalate_human", "retryable_error_codes": []},
        "risk_level": "high",
        "data_sensitivity": "sensitive",
        "est_effort_hours": 8.0,
        "est_context_tokens": 40000,
        "max_cost_budget": {"amount": 50, "currency": "USD"},
        "human_approval_gate": true,
        "tool_permissions": ["read_files", "write_files"]
      },
      {
        "id": "measurement",
        "title": "Run column measurements and QC",
        "kind": "measurement",
        "primary_skill": "micp-instrumentation-qc",
        "collaborator_skill": [],
        "inputs": ["exp_design:protocol", "data_refs:column-batch-01"],
        "outputs": ["measured_uniformity"],
        "depends_on": ["exp_design"],
        "definition_of_done": {
          "artifact": "uniformity_dataset.csv",
          "acceptance_criteria": [
            {"metric": "uniformity_cv", "comparator": "<=", "threshold": 0.3, "unit": "-"},
            {"metric": "qc_passed", "comparator": "==", "threshold": true}
          ]
        },
        "failure_modes": ["sensor drift", "leaching of ammonium"],
        "retry_policy": {"max_attempts": 2, "backoff": "linear", "on_exhaustion": "replan_local", "retryable_error_codes": ["E_TOOL_UNAVAILABLE"]},
        "risk_level": "high",
        "data_sensitivity": "sensitive",
        "est_effort_hours": 6.0,
        "est_context_tokens": 30000,
        "max_cost_budget": {"amount": 40, "currency": "USD"},
        "human_approval_gate": true,
        "tool_permissions": ["read_files", "write_files", "lab_instruments"]
      },
      {
        "id": "audit",
        "title": "Audit uniformity against acceptance criteria",
        "kind": "audit",
        "primary_skill": "micp-reproducibility-versioning",
        "collaborator_skill": [],
        "inputs": ["measurement:measured_uniformity"],
        "outputs": ["audit_report"],
        "depends_on": ["measurement"],
        "definition_of_done": {
          "artifact": "audit_report.json",
          "acceptance_criteria": [
            {"metric": "audit_issues_resolved", "comparator": "==", "threshold": 0}
          ]
        },
        "failure_modes": ["criteria unmet", "data provenance broken"],
        "retry_policy": {"max_attempts": 1, "backoff": "none", "on_exhaustion": "replan_local", "retryable_error_codes": []},
        "risk_level": "low",
        "data_sensitivity": "internal",
        "est_effort_hours": 3.0,
        "est_context_tokens": 20000,
        "max_cost_budget": {"amount": 10, "currency": "USD"},
        "human_approval_gate": false,
        "tool_permissions": ["read_files"]
      },
      {
        "id": "decision",
        "title": "Decide on uniformity optimization path",
        "kind": "decision",
        "primary_skill": "obsidian-decision-gate",
        "collaborator_skill": [],
        "inputs": ["audit:audit_report"],
        "outputs": ["decision_record"],
        "depends_on": ["audit"],
        "definition_of_done": {
          "artifact": "decision_record.json",
          "acceptance_criteria": [
            {"metric": "decision_recorded", "comparator": "==", "threshold": true}
          ]
        },
        "failure_modes": ["insufficient evidence"],
        "retry_policy": {"max_attempts": 1, "backoff": "none", "on_exhaustion": "escalate_human", "retryable_error_codes": []},
        "risk_level": "medium",
        "data_sensitivity": "internal",
        "est_effort_hours": 1.5,
        "est_context_tokens": 15000,
        "max_cost_budget": {"amount": 5, "currency": "USD"},
        "human_approval_gate": false,
        "tool_permissions": ["read_files"]
      }
    ]
  },
  "execution_limits": {
    "max_call_depth": 8,
    "max_iterations": 50,
    "max_parallel_skills": 4
  },
  "findings": [
    {"statement": "Ureolytic pathway produces 2 mol NH4+ per mol CaCO3 precipitated (ammonium must be tracked in all downstream tasks).",
     "epistemic_tag": "CALCULATED", "source": "stoichiometry, references/sources.md S12"},
    {"statement": "Simulation and measurement nodes on the critical path carry the largest duration uncertainty.",
