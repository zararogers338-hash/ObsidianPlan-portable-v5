{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://obsidian.panshi/skills/obsidian-state-manager/input.schema.json",
  "title": "obsidian-state-manager input contract",
  "description": "Unified skill input envelope (Obsidian Plan spec §六) plus action payloads. contract_version 1.0.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "task_id", "project_id", "request", "action", "skill_version", "timestamp"],
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "SemVer-ish contract version. The runtime checks the major: 1.x accepted, 2.x rejected with OSM-E801 (compat policy, spec §十一)."
    },
    "task_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "project_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._-]{1,64}$",
      "description": "Stream name. Also filesystem-safe by construction."
    },
    "request": {"type": "string", "minLength": 1, "description": "Natural-language task statement (spec §六)."},
    "action": {
      "type": "string",
      "enum": [
        "project.init", "project.list",
        "state.get", "state.transition", "state.rollback", "state.timeline", "state.diff",
        "evidence.attach", "evidence.retract",
        "hypothesis.record", "hypothesis.set_status",
        "decision.record",
        "task.checkpoint", "task.resume_plan",
        "memory.promote",
        "review.request", "review.complete",
        "approval.grant",
        "watcher.scan",
        "recovery.recover",
        "snapshot.verify"
      ]
    },
    "context": {"type": "object", "description": "Controller-supplied working context (ephemeral tier)."},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "data_refs": {"type": "array", "items": {"type": "string"}},
    "upstream_outputs": {"type": "array", "items": {"type": "object"}},
    "requested_output_format": {"type": "string", "enum": ["json", "timeline", "summary"], "default": "json"},
    "risk_level": {"type": "string", "enum": ["low", "medium", "high", "critical"], "default": "low"},
    "human_approval_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["granted"],
      "properties": {
        "granted": {"type": "boolean"},
        "approver": {"type": "string"},
        "revision": {"type": "integer", "minimum": 0,
                     "description": "Stream revision the approval was granted against; stale approvals are rejected (OSM-E503)."},
        "scope": {"type": "string"}
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role"],
      "properties": {
        "role": {"type": "string", "enum": ["controller", "skill", "human", "auditor"]},
        "id": {"type": "string"}
      },
      "default": {"role": "skill"}
    },
    "skill_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "controller_version": {"type": "string"},
    "timestamp": {"type": "string", "description": "ISO-8601 caller timestamp."},
    "expected_revision": {
      "type": "integer", "minimum": 0,
      "description": "Optimistic concurrency: caller's view of stream head. Mismatch => OSM-E104."
    },
    "dry_run": {"type": "boolean", "default": false,
                "description": "Validate + simulate only; no events appended, no snapshot written."},
    "auto_downgrade": {"type": "boolean", "default": true,
                       "description": "Allow watcher-triggered automatic downgrade on contradiction."},
    "reason": {"type": "string"},

    "title": {"type": "string", "description": "project.init: human title."},
    "to_state": {
      "type": "string",
      "enum": ["OPEN", "SCOPED", "EVIDENCE_GATHERING", "HYPOTHESIS_BUILDING", "DESIGNING",
               "AWAITING_DATA", "ANALYZING", "UNDER_REVIEW", "VALIDATED", "REJECTED", "DEPLOYABLE"],
      "description": "state.transition / state.rollback target."
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "tier": {"type": "string",
                 "enum": ["project_memory", "ephemeral_context", "verified_knowledge", "unreviewed_draft"],
                 "default": "unreviewed_draft"},
        "summary": {"type": "string"},
        "review_by": {"type": "string", "description": "ISO-8601 expiry horizon for the watcher."},
        "contradicts_hypothesis": {"type": "array", "items": {"type": "string"}}
      },
      "description": "evidence.attach payload."
    },
    "ref": {"type": "string", "description": "evidence.retract / memory.promote target ref."},
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "supporting_evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "id": {"type": "string", "description": "hypothesis.set_status target id."},
    "to_status": {
      "type": "string",
      "enum": ["PROPOSED", "SUPPORTED", "CONTESTED", "REFUTED", "SUPERSEDED"]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "decision"],
      "properties": {
        "id": {"type": "string"},
        "decision": {"type": "string"},
        "rationale": {"type": "string"},
        "alternatives": {"type": "array", "items": {"type": "string"}}
      }
    },
    "completed_work": {"type": "array", "items": {"type": "object"},
                       "description": "task.checkpoint: finished work items (content-hashed for resume dedup)."},
    "pending_work": {"type": "array", "items": {"type": "object"}},
    "candidate_work": {"type": "array", "items": {"type": "object"},
                       "description": "task.resume_plan: work the caller would do; unchanged items are skipped."},
    "to_tier": {"type": "string",
                "enum": ["project_memory", "verified_knowledge", "unreviewed_draft", "ephemeral_context"]},
    "verdict": {"type": "string", "enum": ["pass", "fail"]},
    "reviewer": {"type": "string"},
    "notes": {"type": "string"},
    "scope": {"type": "string"},
    "approver": {"type": "string"},
    "suggest_skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["skill", "reason"],
        "properties": {"skill": {"type": "string"}, "reason": {"type": "string"},
                       "inputs_needed": {"type": "array", "items": {"type": "string"}}}
      }
    }
  }
}
